# Environment configuration example for Telangana Liquor Marketplace Platform
# Keep this file template-only with placeholders. Do not commit actual secrets.

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# Legal Compliance Gates (Telangana State Excise Compliance)
# CRITICAL: Alcohol retail & home delivery are strictly regulated under the Telangana Excise Act.
# Production transactions MUST be disabled by default until explicit statutory authorization is granted.
ALCOHOL_TRANSACTIONS_ENABLED=false
DEMO_MODE=true

# Database Configuration
# Default is local SQLite for instant setup; switch to PostgreSQL in production/staging.
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/alcodelivery_db
DATABASE_URL=sqlite:///./alcodelivery.db

# JWT Security Secrets
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Storage & Third-Party Service Adapters (Mocked by default for demonstration)
STORAGE_PROVIDER=local
S3_BUCKET_NAME=mock-telangana-liquor-assets
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Maps & Geocoding Adapter (Mocked fallback included)
GOOGLE_MAPS_API_KEY=

# Payment Provider Adapter (Simulated gateway in demo mode; real alcohol payments disabled)
PAYMENT_GATEWAY_PROVIDER=simulated
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
