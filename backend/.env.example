# Environment configuration for AlcoRez backend
ENVIRONMENT=development
DEBUG=true

# Legal Compliance (Telangana State Excise Compliance)
ALCOHOL_TRANSACTIONS_ENABLED=false
DEMO_MODE=true

# Database (SQLite by default, or PostgreSQL on Render/Cloud)
DATABASE_URL=sqlite:///./alcodelivery.db

# JWT Security Secrets (In production: min 32 characters, secure random string)
JWT_SECRET_KEY=insecure_dev_key_telangana_alcomarket_secret_min_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Service Adapters
STORAGE_PROVIDER=local
PAYMENT_GATEWAY_PROVIDER=simulated
